<h1 class="mb-4">Усі квитки</h1>

<%= link_to "Додати квиток", new_ticket_path, class: "btn btn-primary mb-3" %>

<% if @tickets.any? %>
  <div class="row">
    <% @tickets.each do |ticket| %>
      <div class="col-md-4 mb-4">
        <div class="card h-100">
          <% if ticket.image.attached? %>
            <%= image_tag ticket.image, class: "card-img-top" %>
          <% end %>

          <div class="card-body">
            <h5 class="card-title"><%= ticket.movie_title %></h5>
            <p class="card-text">
              <strong>Жанр:</strong> <%= ticket.genre %>
            </p>
            <p class="card-text">
              <strong>Автор:</strong> <%= ticket.user.name %>
            </p>
            <p class="card-text">
              <%= truncate(ticket.description, length: 100) %>
            </p>

            <%= link_to "Переглянути", ticket_path(ticket), class: "btn btn-outline-primary" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p>Поки що квитків немає.</p>
<% end %>