
<!DOCTYPE html>
<html>
  <head>
    <title>Кінотеатр Cinema</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <header class="bg-dark text-white p-3">
      <div class="container">
        <h1>Cinema</h1>

        <label for="cinema">Оберіть кінотеатр:</label>
        <select id="cinema" class="form-select w-auto">
          <option>Кінотеатр Cinema</option>
          <option>Кінотеатр IMAX</option>
          <option>Кінотеатр City</option>
        </select>
      </div>
    </header>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container">
        <a class="navbar-brand" href="/">Cinema</a>

        <button class="navbar-toggler" type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarMenu">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMenu">
          <ul class="navbar-nav">

            <li class="nav-item">
              <a class="nav-link" href="/genres">Жанри фільмів</a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/today">Сеанси сьогодні</a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/tomorrow">Сеанси завтра</a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/about">Про проєкт</a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/users/new">Створити користувача</a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/users">Показати всіх користувачів</a>
            </li>

            <li class="nav-item">
              <%= button_to "Видалити всіх користувачів",
                  destroy_all_users_path,
                  method: :delete,
                  class: "btn btn-danger ms-2",
                  data: { turbo_confirm: "Ви дійсно хочете видалити всіх користувачів?" } %>
            </li>

          </ul>
        </div>
      </div>
    </nav>

    <main class="container my-4">
      <%= yield %>
    </main>

    <footer class="bg-dark text-white text-center p-4">
      <p>Увага! Дотримуйтесь вікових обмежень фільмів.</p>
      <p>Контакти розробника: mariia.vatakh.24@pnu.edu.ua</p>
      <p>© 2026 Cinema</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  </body>
</html>